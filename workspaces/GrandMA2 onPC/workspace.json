{
  "friendly_name": "GrandMA2 onPC",
  "description": "MA Lighting grandMA2 onPC v3.9.63.6 \u2014 full show control software running via Wine. Connects to grandMA2 consoles and NPUs over MA-Net2. \u2014 Windows VM streaming launcher for Kasm.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "grandma2.svg",
  "categories": [
    "Utilities"
  ],
  "architecture": [
    "amd64"
  ],
  "notes": "Windows-only/heavy app entry converted to Kasm 1.19 streaming container. The application will run on the Windows VM/VPS streaming host; this tile launches the remote session instead of trying to run the Windows app inside Linux.",
  "run_config": {
    "environment": {
      "TOUCHDESIGNER_STREAM_MODE": "rdp",
      "TOUCHDESIGNER_STREAM_HOST": "",
      "TOUCHDESIGNER_STREAM_PORT": "3389",
      "NVIDIA_VISIBLE_DEVICES": "all",
      "NVIDIA_DRIVER_CAPABILITIES": "all"
    },
    "volumes": {
      "/{username}/windows-stream/remmina": {
        "bind": "/home/kasm-user/.config/remmina",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      }
    },
    "shm_size": "1gb"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -lc '/usr/local/bin/start-touchdesigner-stream.sh'"
    }
  },
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "ghcr.io/perspective0labs/windows-app-stream:1.19.0",
      "uncompressed_size_mb": 5200,
      "available_tags": [
        "1.19.0",
        "latest"
      ]
    }
  ]
}
