{
  "friendly_name": "Hermes Agent",
  "description": "NousResearch Hermes Agent with Kori-x real-time dashboard. Runs the agent gateway (port 8642), built-in dashboard (port 9119), and Kori-x monitoring UI (port 5173).",
  "docker_registry": "https://ghcr.io",
  "image_src": "hermes-agent.svg",
  "categories": [
    "AI",
    "Development"
  ],
  "architecture": [
    "amd64"
  ],
  "run_config": {
    "hostname": "hermes",
    "environment": {
      "HERMES_DASHBOARD": "1",
      "API_SERVER_ENABLED": "true",
      "API_SERVER_HOST": "0.0.0.0",
      "HERMES_HOME": "/opt/data",
      "HERMES_DASHBOARD_DIR": "/opt/hermes-dashboard"
    }
  },
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "ghcr.io/perspective0labs/hermes-agent-dashboard:latest",
      "uncompressed_size_mb": 4200,
      "available_tags": [
        "latest"
      ]
    }
  ]
}