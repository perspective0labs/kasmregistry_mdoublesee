{
  "friendly_name": "Hermes Agent",
  "description": "NousResearch Hermes Agent with built-in web dashboard. The agent and dashboard (port 9119) start together \u2014 manage API keys, config, and sessions from the browser UI.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "hermes-agent.svg",
  "categories": [
    "AI",
    "Development"
  ],
  "architecture": [
    "amd64"
  ],
  "run_config": {
    "environment": {
      "HERMES_DASHBOARD_PORT": "9119"
    },
    "hostname": "hermes"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c \"hermes dashboard --port 9119 &\""
    }
  },
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "nousresearch/hermes-agent:latest",
      "uncompressed_size_mb": 3400,
      "available_tags": [
        "latest",
        "main",
        "v2026.6.5"
      ]
    }
  ]
}