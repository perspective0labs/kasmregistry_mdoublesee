{
  "friendly_name": "Notch.one",
  "description": "Notch.one / Notch Builder remote workspace for Kasm. Launches a streaming/RDP session to the Windows VM that hosts video-heavy Windows applications.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "notch.svg",
  "categories": [
    "Graphics",
    "Utilities"
  ],
  "architecture": [
    "amd64"
  ],
  "notes": "Video-heavy Windows app: intentionally uses the Windows VM streaming launcher, not Wine. Configure TOUCHDESIGNER_STREAM_HOST/PORT or the saved Remmina profile to point at the Windows VM.",
  "run_config": {
    "environment": {
      "TOUCHDESIGNER_STREAM_MODE": "rdp",
      "TOUCHDESIGNER_STREAM_HOST": "",
      "TOUCHDESIGNER_STREAM_PORT": "3389",
      "NVIDIA_VISIBLE_DEVICES": "all",
      "NVIDIA_DRIVER_CAPABILITIES": "all"
    },
    "volumes": {
      "/{username}/notch/remmina": {
        "bind": "/home/kasm-user/.config/remmina",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      }
    },
    "shm_size": "1gb"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -lc '/usr/local/bin/start-touchdesigner-stream.sh'"
    }
  },
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "ghcr.io/perspective0labs/windows-app-stream:1.19.0",
      "uncompressed_size_mb": 5200,
      "available_tags": [
        "1.19.0",
        "latest"
      ]
    }
  ]
}
