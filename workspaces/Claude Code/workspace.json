{
  "friendly_name": "Claude Code (Qwen)",
  "description": "Claude Code CLI routed through a local LiteLLM proxy running qwen2.5-coder:7b via Ollama \u2014 no API credits consumed.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "claude-code.svg",
  "categories": [
    "Development",
    "AI"
  ],
  "architecture": [
    "amd64",
    "arm64"
  ],
  "notes": "Uses qwen2.5-coder:7b-32k (Ollama \u2192 LiteLLM proxy at 172.17.0.1:4001). No API key required.\n\nRequires LiteLLM proxy running in WSL2 (systemd: litellm.service) and Ollama on the Windows host.",
  "run_config": {
    "environment": {
      "ANTHROPIC_BASE_URL": "http://172.17.0.1:4001",
      "ANTHROPIC_API_KEY": "sk-local"
    },
    "volumes": {
      "/{username}/claude-code": {
        "bind": "/home/kasm-user/.claude",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      }
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash"
    }
  },
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "kasmweb/claude-code:1.19.0-rolling-weekly",
      "uncompressed_size_mb": 5000,
      "available_tags": [
        "1.19.0-rolling-weekly",
        "1.18.0-rolling-weekly"
      ]
    }
  ]
}