{
  "friendly_name": "Claude Code (Qwen)",
  "description": "Claude Code CLI with Ollama + qwen2.5-coder:7b running inside the container — GPU-accelerated, no external proxy needed.",
  "docker_registry": "https://ghcr.io",
  "image_src": "claude-code.svg",
  "categories": [
    "Development",
    "AI"
  ],
  "architecture": [
    "amd64"
  ],
  "notes": "Ollama and LiteLLM start automatically inside the container. First launch pulls qwen2.5-coder:7b (~4.7 GB) — subsequent launches use the cached model from the ollama-models volume.\n\nRequires NVIDIA GPU passthrough enabled in Kasm (nvidia runtime). Model choice can be overridden via the OLLAMA_MODEL environment variable.",
  "run_config": {
    "environment": {
      "ANTHROPIC_BASE_URL": "http://localhost:4001",
      "ANTHROPIC_API_KEY": "sk-local",
      "OLLAMA_MODEL": "qwen2.5-coder:7b",
      "NVIDIA_VISIBLE_DEVICES": "all",
      "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
    },
    "volumes": {
      "/{username}/ollama-models": {
        "bind": "/root/.ollama",
        "mode": "rw"
      },
      "/{username}/claude-code": {
        "bind": "/home/kasm-user/.claude",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      }
    }
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c \"/usr/local/bin/start-services.sh\""
    }
  },
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "ghcr.io/perspective0labs/claude-code-qwen:latest",
      "uncompressed_size_mb": 8000,
      "available_tags": [
        "latest"
      ]
    },
    {
      "version": "1.19.x",
      "image": "ghcr.io/perspective0labs/claude-code-qwen:latest",
      "uncompressed_size_mb": 8000,
      "available_tags": [
        "latest"
      ]
    }
  ],
  "cores": 0.5,
  "memory": 1536
}
