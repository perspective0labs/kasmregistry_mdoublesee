{
  "friendly_name": "Unreal Engine",
  "description": "Unreal Engine 5.8 editor (dev-slim) \u2014 full Linux editor and build tools for real-time 3D, virtual production and pixel streaming projects.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "unreal.svg",
  "categories": [
    "Development",
    "Multimedia"
  ],
  "architecture": [
    "amd64"
  ],
  "notes": "Uses wukakuki/unreal-engine:dev-5.8.1 as requested. Requires GPU agent/NVIDIA Container Toolkit for usable editor performance. Large image; first pull needs significant disk and time.",
  "run_config": {
    "environment": {
      "NVIDIA_DRIVER_CAPABILITIES": "all",
      "NVIDIA_VISIBLE_DEVICES": "all"
    },
    "volumes": {
      "/{username}/unreal": {
        "bind": "/home/kasm-user/Documents",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      },
      "/{username}/unreal-shadercache": {
        "bind": "/home/kasm-user/.config/Epic",
        "mode": "rw",
        "uid": 1000,
        "gid": 1000
      }
    },
    "shm_size": "2gb"
  },
  "cores": 0.5,
  "memory": 1536,
  "gpu_count": 1,
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "wukakuki/unreal-engine:dev-5.8.1",
      "uncompressed_size_mb": 49000,
      "available_tags": [
        "dev-5.8.1"
      ]
    }
  ]
}
