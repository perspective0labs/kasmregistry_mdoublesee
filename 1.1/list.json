est"]}],"sha":"283dbe8ddc67239d49938f68dbf2331286fd7a4c"},{"friendly_name":"ChamSys MagicQ","description":"ChamSys MagicQ professional lighting console software. Full 64-universe DMX control, visualiser, and fixture library. Shows persist across sessions.","docker_registry":"https://ghcr.io","image_src":"magicq.png","categories":["Entertainment","Media Production"],"architecture":["amd64"],"run_config":{"environment":{"KASM_PROFILE_PATH":"/{username}/chamsys-magicq"}},"exec_config":{"go":{"cmd":"bash -c \"/opt/magicq/runmagicq.sh\""}},"persistent_profile_config":{"enabled":true,"profile_path":"/mnt/kasm_profiles/{username}/{image_id}","max_size_mb":2048},"cores":2,"memory":3072,"notes":"Shows are stored persistently under ~/MagicQ/shows. Heads and personalities are pre-expanded in the image. MagicQ PC edition — 64 universes fully enabled.","compatibility":[{"version":"1.16.x","image":"ghcr.io/perspective0labs/magicq-kasm:latest","uncompressed_size_mb":3500,"available_tags":["latest","1.9.7.4"]},{"version":"1.17.x","image":"ghcr.io/perspective0labs/magicq-kasm:latest","uncompressed_size_mb":3500,"available_tags":["latest","1.9.7.4"]},{"version":"1.18.x","image":"ghcr.io/perspective0labs/magicq-kasm:latest","uncompressed_size_mb":3500,"available_tags":["latest","1.9.7.4"]}],"sha":"6d94c5e053566e8364e33c01dd560495a10eb812"},{"friendly_name":"Claude Code Pro","description":"Claude Code CLI using your Anthropic Pro plan — full Claude models with no local proxy.","docker_registry":"https://index.docker.io/v1/","image_src":"claude-code-pro.svg","categories":["Development","AI"],"architecture":["amd64","arm64"],"notes":"Connects directly to Anthropic. First launch: run `claude` and authenticate with your Pro account via `claude auth login`, or set ANTHROPIC_API_KEY in Kasm's workspace environment variables.\n\nCredentials are persisted in the /{username}/claude-code-pro volume.","run_config":{"volumes":{"/{username}/claude-code-pro":{"bind":"/home/kasm-user/.claude","mode":"rw","uid":1000,"gid":1000}}},"exec_config":{"go":{"cmd":"bash"}},"compatibility":[{"version":"1.18.x","image":"kasmweb/claude-code:1.19.0-rolling-weekly","uncompressed_size_mb":5000,"available_tags":["1.19.0-rolling-weekly","1.18.0-rolling-weekly"]}],"sha":"f5f3b7a7650f1fd1adf37222bde98043c1768e65"},{"friendly_name":"Claude Code (Qwen)","description":"Claude Code CLI with Ollama + qwen2.5-coder:7b running inside the container — GPU-accelerated, no external proxy needed.","docker_registry":"https://ghcr.io","image_src":"claude-code.svg","categories":["Development","AI"],"architecture":["amd64"],"notes":"Ollama and LiteLLM start automatically inside the container. First launch pulls qwen2.5-coder:7b (~4.7 GB) — subsequent launches use the cached model from the ollama-models volume.\n\nRequires NVIDIA GPU passthrough enabled in Kasm (nvidia runtime). Model choice can be overridden via the OLLAMA_MODEL environment variable.","run_config":{"environment":{"ANTHROPIC_BASE_URL":"http://localhost:4001","ANTHROPIC_API_KEY":"sk-local","OLLAMA_MODEL":"qwen2.5-coder:7b","NVIDIA_VISIBLE_DEVICES":"all","NVIDIA_DRIVER_CAPABILITIES":"compute,utility"},"volumes":{"/{username}/ollama-models":{"bind":"/root/.ollama","mode":"rw"},"/{username}/claude-code":{"bind":"/home/kasm-user/.claude","mode":"rw","uid":1000,"gid":1000}}},"exec_config":{"go":{"cmd":"bash -c \"/usr/local/bin/start-services.sh\""}},"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/claude-code-qwen:latest","uncompressed_size_mb":8000,"available_tags":["latest"]}],"sha":"e33aa1e9182dd2a0c7c11a09b5d049d355147980"},{"friendly_name":"GravityMark","description":"GravityMark GPU benchmark — requires a GPU-capable Kasm agent.","docker_registry":"https://ghcr.io","image_src":"grv.svg","categories":["Utilities"],"architecture":["amd64"],"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/gravitymark:latest","uncompressed_size_mb":4000,"available_tags":["latest"]}],"notes":"Requires GPU agent (gpu_count ≥ 1). Will not start on CPU-only agents.","sha":"507aa9b36715ab70b12411e5977a2997da276500"},{"friendly_name":"Hermes Agent","description":"NousResearch Hermes Agent with Kori-x real-time dashboard. Built-in s6-overlay supervision runs the gateway, built-in dashboard, and Kori-x monitoring UI together in one container.","docker_registry":"https://ghcr.io","image_src":"hermes-agent.svg","categories":["AI","Development"],"architecture":["amd64"],"notes":"Set Proxy Port to 5173 for the Kori-x monitoring dashboard, or 9119 for the built-in config/session dashboard, or 8642 for raw API access.\n\nDefault model: qwen2.5-coder:7b-32k (local Ollama via LiteLLM proxy at 172.17.0.1:4001).\n\nMount a persistent volume at /opt/data to preserve config, API keys, sessions, skills, and memories across workspace restarts.\n\nPorts: 8642 (OpenAI-compatible API + health), 9119 (built-in dashboard), 5173 (Kori-x UI), 3001 (Kori-x WebSocket), 3002 (Kori-x wiki API).","run_config":{"hostname":"hermes","environment":{"HERMES_DASHBOARD":"1","API_SERVER_ENABLED":"true","API_SERVER_HOST":"0.0.0.0","HERMES_HOME":"/opt/data","HERMES_DASHBOARD_DIR":"/opt/hermes-dashboard","OPENAI_BASE_URL":"http://172.17.0.1:4001/v1","OPENAI_API_KEY":"sk-local"},"volumes":{"/{username}/hermes-agent":{"bind":"/opt/data","mode":"rw"}}},"exec_config":{"go":{"cmd":"bash -c \"/init\""}},"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/hermes-agent-dashboard:latest","uncompressed_size_mb":4200,"available_tags":["latest"]}],"sha":"1207b1f7bbf04e7530569360ff098793f8814620"},{"friendly_name":"Home Assistant","description":"Open-source home automation platform. Control smart home devices, create automations, and monitor your home from a unified web interface on port 8123.","docker_registry":"https://index.docker.io/v1/","image_src":"home-assistant.svg","categories":["Automation","Utilities"],"architecture":["amd64","arm64"],"compatibility":[{"version":"1.18.x","image":"homeassistant/home-assistant:stable","uncompressed_size_mb":2200,"available_tags":["stable","latest"]}],"sha":"e6a5640b98fe853f979efcace87f4cccec3c99fd"},{"friendly_name":"IW3","description":"IW3 (Call of Duty) streamed desktop game — requires GPU agent.","docker_registry":"https://ghcr.io","image_src":"iw3.svg","categories":["Utilities"],"architecture":["amd64"],"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/iw3:latest","uncompressed_size_mb":8000,"available_tags":["latest"]}],"notes":"Requires GPU agent (gpu_count ≥ 1). Will not start on CPU-only agents.","sha":"70b46baff2d2132e4745c099f4176abf27b15591"},{"friendly_name":"Kali Linux","description":"Kali Linux rolling desktop for penetration testing and security research.","docker_registry":"https://ghcr.io","image_src":"kali.svg","categories":["Development","Utilities"],"architecture":["amd64"],"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/kali-linux:latest","uncompressed_size_mb":5000,"available_tags":["latest"]}],"sha":"bfce938bf345bf4cb88b5034af7f5c0a2ac5de30"},{"friendly_name":"KasmOS","description":"KasmOS custom desktop environment.","docker_registry":"https://ghcr.io","image_src":"kos.svg","categories":["Utilities"],"architecture":["amd64"],"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/kasmos:latest","uncompressed_size_mb":3800,"available_tags":["latest"]}],"sha":"362a210338c5938b797c157088c21a8b4fe8ff4a"},{"friendly_name":"LichtFeld Studio","description":"LichtFeld Studio — AI-assisted creative environment. Requires GPU agent.","docker_registry":"https://ghcr.io","image_src":"lch.svg","categories":["Development","AI"],"architecture":["amd64"],"compatibility":[{"version":"1.18.x","image":"ghcr.io/perspective0labs/lichtfeld-studio:latest","uncompressed_size_mb":6000,"available_tags":["latest"]}],"notes":"Requires GPU agent (gpu_count ≥ 1). Will not start on CPU-only agents.","sha":"1d62d1aa215e8dbd428b258db1d01a4282ce2877"},{"friendly_name":"LiteLLM","description":"LiteLLM Proxy - a unified API gateway for 100+ LLMs including OpenAI, Anthropic, Gemini and local models. Exposes an OpenAI-compatible endpoint on port 4000.","docker_registry":"https://index.docker.io/v1/","image_src":"litellm.svg","categories":["AI","Development"],"architecture":["amd64","arm64"],"notes":"Configured to route all requests to local Ollama (qwen2.5-coder:7b-32k) via the WSL2 host at 172.22.48.1:11434.\n\nAnthropics fallback: set ANTHROPIC_API_KEY in the environment to enable.\n\nProxy API key: sk-local\nProxy port: 4000 (inside container)\nSet Kasm Proxy Port to 4000 for API access.","run_config":{"environment":{"LITELLM_MASTER_KEY":"sk-local","LITELLM_LOG":"WARNING"},"volumes":{"/{username}/litellm":{"bind":"/app/config","mode":"ro","uid":1000,"gid":1000}}},"exec_config":{"go":{"cmd":"bash -c \"litellm --config /app/config/config.yaml --port 4000 --host 0.0.0.0\""}},"compatibility":[{"version":"1.18.x","image":"litellm/litellm:v1.88.2","uncompressed_size_mb":1100,"available_tags":["latest","v1.88.2"]}],"sha":"864523594e03078eefa28045c9d335eba9af0704"},{"friendly_name":"MasterTour Pro","description":"Lakeside Software MasterTour Pro touring and production management. Manage crew, vendors, travel, budgets, and advancing from one place.","docker_registry":"https://ghcr.io","image_src":"mastertour.svg","categories":["Entertainment","Media Production"],"architecture":["amd64"],"run_config":{"environment":{}},"exec_config":{"go":{"cmd":"bash -c \"/opt/mastertour/squashfs-root/AppRun\""}},"cores":2,"memory":2048,"notes":"MasterTour Pro 3.9.2. Login with your MasterTour account on first launch.","compatibility":[{"version":"1.16.x","image":"ghcr.io/perspective0labs/mastertour-kasm:latest","uncompressed_size_mb":1800,"available_tags":["latest","3.9.2"]},{"version":"1.17.x","image":"ghcr.io/perspective0labs/mastertour-kasm:latest","uncompressed_size_mb":1800,"available_tags":["latest","3.9.2"]},{"version":"1.18.x","image":"ghcr.io/perspective0